{
  "name": "@local/dsh-model-order-settings",
  "version": "1.0.0",
  "author": "kyf778 <694982318@qq.com>",
  "description": "Model & provider ordering settings page for DeepSeek Harness.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "model-order",
    "settings",
    "plugin"
  ],
  "license": "MIT",
  "icon": "./icon.svg",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kyf778/dsh-model-order-settings.git"
  },
  "bugs": {
    "url": "https://github.com/kyf778/dsh-model-order-settings/issues"
  },
  "homepage": "https://github.com/kyf778/dsh-model-order-settings#readme",
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
